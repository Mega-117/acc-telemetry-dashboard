rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCurrentUserCoach() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }

    function isCoachOfUser(userId) {
      return isCurrentUserCoach()
             && exists(/databases/$(database)/documents/users/$(userId))
             && get(/databases/$(database)/documents/users/$(userId)).data.coachId == request.auth.uid;
    }

    function isBoundedNullableString(value, maxSize) {
      return value == null || (value is string && value.size() <= maxSize);
    }

    // === Pit Wall (PIP-359) ===
    // Il collegamento fra pilota e ingegnere e' un permesso fra due account,
    // non una stanza con password. L'id del grant e' derivato dai due uid,
    // cosi' non possono esistere due permessi divergenti per la stessa coppia.

    function pitwallGrantId(driverUid, engineerUid) {
      return driverUid + '__' + engineerUid;
    }

    function pitwallGrantPath(driverUid, engineerUid) {
      return /databases/$(database)/documents/pitwallGrants/$(pitwallGrantId(driverUid, engineerUid));
    }

    /**
     * L'utente corrente puo' assistere questo pilota adesso.
     * Un permesso "solo per questa volta" oltre la sua scadenza vale come una
     * revoca: il controllo sta qui sul server, non solo nel client.
     */
    function hasPitwallGrant(driverUid) {
      return isSignedIn()
             && exists(pitwallGrantPath(driverUid, request.auth.uid))
             && get(pitwallGrantPath(driverUid, request.auth.uid)).data.status == 'granted'
             && (get(pitwallGrantPath(driverUid, request.auth.uid)).data.get('expiresAtMs', null) == null
                 || get(pitwallGrantPath(driverUid, request.auth.uid)).data.expiresAtMs > request.time.toMillis());
    }

    /** Pilota assistito o ingegnere autorizzato: i soli due ruoli del canale. */
    function isPitwallParticipant(driverUid) {
      return isOwner(driverUid) || hasPitwallGrant(driverUid);
    }

    function validPitwallGrantShape(grantId, driverUid, engineerUid) {
      return request.resource.data.keys().hasAll([
               'schemaVersion', 'driverUid', 'engineerUid', 'status',
               'createdBy', 'createdAt', 'updatedAt'
             ])
             && request.resource.data.keys().hasOnly([
               'schemaVersion', 'driverUid', 'engineerUid', 'status',
               'createdBy', 'createdAt', 'updatedAt', 'note', 'scope', 'expiresAtMs', 'requestedScope'
             ])
             && request.resource.data.schemaVersion == 1
             && request.resource.data.driverUid is string
             && request.resource.data.engineerUid is string
             && request.resource.data.driverUid != request.resource.data.engineerUid
             && grantId == pitwallGrantId(request.resource.data.driverUid, request.resource.data.engineerUid)
             && request.resource.data.status in ['pending', 'granted', 'revoked']
             && request.resource.data.createdBy is string
             && request.resource.data.createdAt is string
             && request.resource.data.createdAt.size() <= 40
             && request.resource.data.updatedAt is string
             && request.resource.data.updatedAt.size() <= 40
             && isBoundedNullableString(request.resource.data.get('note', null), 200)
             // Portata del permesso: "solo per questa volta" ha una scadenza
             // obbligatoria, "sempre" non ne ha. Assenti = "sempre" storico.
             && (request.resource.data.get('scope', null) == null
                 || request.resource.data.scope in ['once', 'always'])
             && (request.resource.data.get('expiresAtMs', null) == null
                 || (request.resource.data.expiresAtMs is number && request.resource.data.expiresAtMs > 0))
             && (request.resource.data.get('scope', null) != 'once'
                 || request.resource.data.get('expiresAtMs', null) != null)
             && (request.resource.data.get('scope', null) != 'always'
                 || request.resource.data.get('expiresAtMs', null) == null)
             // Cio' che l'ingegnere ha chiesto: propone, non decide.
             && (request.resource.data.get('requestedScope', null) == null
                 || request.resource.data.requestedScope in ['once', 'always'])
             // Non si chiede un collegamento a un account che non esiste.
             && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.driverUid))
             && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.engineerUid));
    }

    /** L'ingegnere chiede: nasce in attesa e non si auto-approva. */
    function validPitwallGrantRequest() {
      return request.resource.data.engineerUid == request.auth.uid
             && request.resource.data.createdBy == request.auth.uid
             && request.resource.data.status == 'pending';
    }

    /** Il pilota pre-autorizza: nasce gia' valido, ma solo per mano sua. */
    function validPitwallGrantPreAuthorisation() {
      return request.resource.data.driverUid == request.auth.uid
             && request.resource.data.createdBy == request.auth.uid
             && request.resource.data.status == 'granted';
    }

    /** Su un grant esistente cambia solo lo stato: le identita' sono fissate. */
    function pitwallGrantIdentityUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'note', 'scope', 'expiresAtMs', 'requestedScope'])
             && request.resource.data.driverUid == resource.data.driverUid
             && request.resource.data.engineerUid == resource.data.engineerUid
             && request.resource.data.createdBy == resource.data.createdBy
             && request.resource.data.createdAt == resource.data.createdAt;
    }

    /**
     * Fotografia della strategia nel Pit MFD, dentro la presenza.
     * Piccola, lenta (stessa scrittura ogni 30 secondi) e limitata: NON e' il
     * canale di telemetria live, che resta diretto fra i due PC.
     */
    function validPitwallStrategySnapshot(snapshot) {
      return snapshot.keys().hasOnly(['fuelToAdd', 'tyreSet', 'pressures', 'compound', 'updatedAt'])
             && (snapshot.get('compound', null) == null
                 || snapshot.compound in ['dry', 'wet'])
             && (snapshot.get('fuelToAdd', null) == null
                 || (snapshot.fuelToAdd is number && snapshot.fuelToAdd >= 0 && snapshot.fuelToAdd <= 200))
             && (snapshot.get('tyreSet', null) == null
                 || (snapshot.tyreSet is number && snapshot.tyreSet >= 0 && snapshot.tyreSet <= 60))
             && (snapshot.get('pressures', null) == null
                 || (snapshot.pressures is map && snapshot.pressures.keys().hasOnly(['FL', 'FR', 'RL', 'RR'])))
             && snapshot.updatedAt is string
             && snapshot.updatedAt.size() <= 40;
    }

    function validPitwallSession(driverUid) {
      return request.resource.data.keys().hasAll([
               'schemaVersion', 'driverUid', 'sessionId', 'online', 'updatedAt'
             ])
             && request.resource.data.keys().hasOnly([
               'schemaVersion', 'driverUid', 'sessionId', 'online', 'updatedAt', 'car', 'track', 'crew', 'strategy'
             ])
             && request.resource.data.schemaVersion == 1
             && request.resource.data.driverUid == driverUid
             && request.resource.data.sessionId is string
             && request.resource.data.sessionId.size() <= 80
             && request.resource.data.online is bool
             && request.resource.data.updatedAt is string
             && request.resource.data.updatedAt.size() <= 40
             && isBoundedNullableString(request.resource.data.get('car', null), 80)
             && isBoundedNullableString(request.resource.data.get('track', null), 80)
             // Equipaggio della vettura: al massimo 16 voci, come la EntryList.
             && (request.resource.data.get('crew', null) == null
                 || (request.resource.data.crew is list && request.resource.data.crew.size() <= 16))
             && (request.resource.data.get('strategy', null) == null
                 || validPitwallStrategySnapshot(request.resource.data.strategy));
    }

    /**
     * Segnalazione WebRTC: solo il necessario a farsi trovare, mai telemetria.
     * Il payload e' limitato perche' un SDP e' grande ma non illimitato.
     */
    function validPitwallSignal(driverUid) {
      return request.resource.data.keys().hasAll(['schemaVersion', 'from', 'to', 'kind', 'payload', 'createdAt'])
             && request.resource.data.keys().hasOnly(['schemaVersion', 'from', 'to', 'kind', 'payload', 'createdAt'])
             && request.resource.data.schemaVersion == 1
             && request.resource.data.from == request.auth.uid
             && request.resource.data.to is string
             && request.resource.data.to != request.auth.uid
             && (request.resource.data.from == driverUid || request.resource.data.to == driverUid)
             && request.resource.data.kind in ['offer', 'answer', 'ice']
             && request.resource.data.payload is string
             && request.resource.data.payload.size() <= 16000
             && request.resource.data.createdAt is string
             && request.resource.data.createdAt.size() <= 40;
    }

    /**
     * Ordine di strategia: rete di sicurezza quando il canale diretto non c'e'.
     * E' raro e piccolo; la telemetria non passa mai di qui.
     */
    function validPitwallOrder(orderId) {
      return request.resource.data.keys().hasAll([
               'schemaVersion', 'orderId', 'revision', 'senderId', 'issuedAt', 'status', 'plan'
             ])
             && request.resource.data.keys().hasOnly([
               'schemaVersion', 'orderId', 'revision', 'senderId', 'issuedAt', 'expiresAt', 'status', 'plan'
             ])
             && request.resource.data.schemaVersion == 1
             && request.resource.data.orderId == orderId
             && request.resource.data.orderId.size() <= 80
             && request.resource.data.revision is int
             && request.resource.data.revision >= 0
             && request.resource.data.senderId == request.auth.uid
             && request.resource.data.issuedAt is string
             && request.resource.data.issuedAt.size() <= 40
             && isBoundedNullableString(request.resource.data.get('expiresAt', null), 40)
             && request.resource.data.status == 'pending'
             && request.resource.data.plan is map
             && request.resource.data.plan.keys().size() <= 12;
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function validInitialPilotUser(userId) {
      return request.resource.data.keys().hasAll([
               'uid', 'email', 'nickname', 'role', 'coachId', 'createdAt',
               'emailVerified', 'directorySortName', 'searchPrefixes'
             ])
             && request.resource.data.keys().hasOnly([
               'uid', 'email', 'firstName', 'lastName', 'nickname', 'role',
               'coachId', 'createdAt', 'emailVerified', 'directorySortName',
               'searchPrefixes'
             ])
             && request.resource.data.uid == userId
             && request.resource.data.uid == request.auth.uid
             && request.resource.data.email == request.auth.token.get('email', null)
             && request.resource.data.emailVerified == request.auth.token.get('email_verified', false)
             && request.resource.data.nickname is string
             && request.resource.data.nickname.size() > 0
             && request.resource.data.role == 'pilot'
             && request.resource.data.coachId == null
             && request.resource.data.createdAt is string
             && request.resource.data.get('firstName', '') is string
             && request.resource.data.get('lastName', '') is string
             && request.resource.data.directorySortName is string
             && request.resource.data.directorySortName.size() > 0
             && request.resource.data.searchPrefixes is list
             && request.resource.data.searchPrefixes.size() <= 200;
    }

    function validOwnerUserUpdate(userId) {
      return request.resource.data.uid == userId
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'uid', 'email', 'emailVerified', 'firstName', 'lastName',
               'nickname', 'directorySortName', 'searchPrefixes', 'equipment',
               'stats', 'sessionIndex', 'suiteVersion', 'suiteVersionDetail',
               'suiteVersionUpdatedAt', 'clientRuntime', 'maintenance'
             ])
             && request.resource.data.get('role', null) == resource.data.get('role', null)
             && request.resource.data.get('coachId', null) == resource.data.get('coachId', null)
             && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
             && (!resource.data.keys().hasAny(['role']) || request.resource.data.keys().hasAny(['role']))
             && (!resource.data.keys().hasAny(['coachId']) || request.resource.data.keys().hasAny(['coachId']))
             && (!resource.data.keys().hasAny(['createdAt']) || request.resource.data.keys().hasAny(['createdAt']))
             && (!resource.data.keys().hasAny(['email']) || request.resource.data.keys().hasAny(['email']))
             && (!resource.data.keys().hasAny(['emailVerified']) || request.resource.data.keys().hasAny(['emailVerified']))
             && (
               !request.resource.data.keys().hasAny(['email'])
               || request.resource.data.email == request.auth.token.get('email', null)
             )
             && (
               !request.resource.data.keys().hasAny(['emailVerified'])
               || request.resource.data.emailVerified == request.auth.token.get('email_verified', false)
             );
    }

    function validPublicProfileFields(userId) {
      return request.resource.data.keys().hasAll(['uid', 'nickname', 'avatarUrl', 'updatedAt'])
             && request.resource.data.uid == userId
             && request.resource.data.nickname is string
             && request.resource.data.nickname.size() > 0
             && isNullableString(request.resource.data.avatarUrl)
             && request.resource.data.updatedAt is string
             && request.resource.data.get('createdAt', '') is string;
    }

    function validPublicProfileCreate(userId) {
      return validPublicProfileFields(userId)
             && request.resource.data.keys().hasOnly([
               'uid', 'nickname', 'avatarUrl', 'createdAt', 'updatedAt'
             ]);
    }

    function validOwnerPublicProfileUpdate(userId) {
      return validPublicProfileFields(userId)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'nickname', 'avatarUrl', 'updatedAt'
             ]);
    }

    function validAdminPublicProfileUpdate(userId) {
      return validPublicProfileFields(userId)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'uid', 'nickname', 'avatarUrl', 'createdAt', 'updatedAt'
             ]);
    }

    function validPilotDirectoryFields(userId) {
      return request.resource.data.keys().hasAll([
               'schemaVersion', 'uid', 'firstName', 'lastName', 'nickname',
               'role', 'coachId', 'sessionsLast7Days', 'lastSessionDate',
               'suiteVersion', 'suiteVersionUpdatedAt', 'clientChannel',
               'clientUpdateState', 'clientLastHeartbeatAt',
               'directorySortName', 'searchPrefixes'
             ])
             && request.resource.data.schemaVersion == 1
             && request.resource.data.uid == userId
             && request.resource.data.firstName is string
             && request.resource.data.lastName is string
             && request.resource.data.nickname is string
             && request.resource.data.nickname.size() > 0
             && request.resource.data.role in ['pilot', 'coach', 'admin']
             && isNullableString(request.resource.data.coachId)
             && request.resource.data.sessionsLast7Days is number
             && request.resource.data.sessionsLast7Days >= 0
             && isNullableString(request.resource.data.lastSessionDate)
             && isNullableString(request.resource.data.suiteVersion)
             && isNullableString(request.resource.data.suiteVersionUpdatedAt)
             && isNullableString(request.resource.data.clientChannel)
             && isNullableString(request.resource.data.clientUpdateState)
             && isNullableString(request.resource.data.clientLastHeartbeatAt)
             && request.resource.data.directorySortName is string
             && request.resource.data.directorySortName.size() > 0
             && request.resource.data.searchPrefixes is list
             && request.resource.data.searchPrefixes.size() <= 200
             && isNullableString(request.resource.data.get('firebaseHealthStatus', null))
             && (
               request.resource.data.get('firebaseHealthMigrationVersion', null) == null
               || (
                 request.resource.data.firebaseHealthMigrationVersion is number
                 && request.resource.data.firebaseHealthMigrationVersion >= 0
               )
             )
             && isNullableString(request.resource.data.get('firebaseHealthCheckedAt', null))
             && isNullableString(request.resource.data.get('firebaseHealthCode', null));
    }

    function pilotDirectoryRoleAndCoachMatchUser(userId) {
      return request.resource.data.role == getAfter(/databases/$(database)/documents/users/$(userId)).data.role
             && request.resource.data.coachId == getAfter(/databases/$(database)/documents/users/$(userId)).data.get('coachId', null);
    }

    function validPilotDirectoryCreate(userId) {
      return validPilotDirectoryFields(userId)
             && request.resource.data.keys().hasOnly([
               'schemaVersion', 'uid', 'firstName', 'lastName', 'nickname',
               'role', 'coachId', 'sessionsLast7Days', 'lastSessionDate',
               'suiteVersion', 'suiteVersionUpdatedAt', 'clientChannel',
               'clientUpdateState', 'clientLastHeartbeatAt',
               'directorySortName', 'searchPrefixes', 'firebaseHealthStatus',
               'firebaseHealthMigrationVersion', 'firebaseHealthCheckedAt',
               'firebaseHealthCode'
             ])
             && pilotDirectoryRoleAndCoachMatchUser(userId);
    }

    function validPilotDirectoryUpdate(userId) {
      return validPilotDirectoryFields(userId)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'schemaVersion', 'uid', 'firstName', 'lastName', 'nickname',
               'role', 'coachId', 'sessionsLast7Days', 'lastSessionDate',
               'suiteVersion', 'suiteVersionUpdatedAt', 'clientChannel',
               'clientUpdateState', 'clientLastHeartbeatAt',
               'directorySortName', 'searchPrefixes', 'firebaseHealthStatus',
               'firebaseHealthMigrationVersion', 'firebaseHealthCheckedAt',
               'firebaseHealthCode'
             ])
             && pilotDirectoryRoleAndCoachMatchUser(userId);
    }

    function validRuntimeComponents(components) {
      return components is map
             && components.keys().hasAll(['launcher', 'logger', 'webapp', 'kokoroRuntime'])
             && components.keys().hasOnly(['launcher', 'logger', 'webapp', 'kokoroRuntime'])
             && isBoundedNullableString(components.launcher, 80)
             && isBoundedNullableString(components.logger, 80)
             && isBoundedNullableString(components.webapp, 80)
             && isBoundedNullableString(components.kokoroRuntime, 80);
    }

    function validRuntimeHealth(health) {
      return health is map
             && health.keys().hasAll(['status', 'phase', 'reasonCode'])
             && health.keys().hasOnly(['status', 'phase', 'reasonCode'])
             && health.status is string && health.status.size() <= 40
             && health.phase is string && health.phase.size() <= 40
             && isBoundedNullableString(health.reasonCode, 80);
    }

    function validRuntimeMigration(migration) {
      return migration is map
             && migration.keys().hasAll(['status', 'phase', 'progress', 'code', 'resumedFrom'])
             && migration.keys().hasOnly(['status', 'phase', 'progress', 'code', 'resumedFrom'])
             && migration.status is string && migration.status.size() <= 40
             && migration.phase is string && migration.phase.size() <= 80
             && migration.progress is number
             && migration.progress >= 0 && migration.progress <= 100
             && isBoundedNullableString(migration.code, 80)
             && isBoundedNullableString(migration.resumedFrom, 80);
    }

    function validRuntimeInstallation(installationId) {
      return request.resource.data.keys().hasAll([
               'schemaVersion', 'installationId', 'startedAt', 'lastContactAt',
               'suiteVersion', 'channel', 'updateState', 'lastCheckAt',
               'components', 'health', 'migration'
             ])
             && request.resource.data.keys().hasOnly([
               'schemaVersion', 'installationId', 'startedAt', 'lastContactAt',
               'lastSuiteLaunchAt', 'lastDashboardOpenedAt',
               'suiteVersion', 'channel', 'updateState', 'lastCheckAt',
               'components', 'health', 'migration'
             ])
             && request.resource.data.schemaVersion == 2
             && request.resource.data.installationId == installationId
             && installationId.size() <= 80
             && request.resource.data.startedAt is string
             && request.resource.data.startedAt.size() <= 40
             && request.resource.data.lastContactAt is string
             && request.resource.data.lastContactAt.size() <= 40
             && isBoundedNullableString(request.resource.data.get('lastSuiteLaunchAt', null), 40)
             && isBoundedNullableString(request.resource.data.get('lastDashboardOpenedAt', null), 40)
             && isBoundedNullableString(request.resource.data.suiteVersion, 80)
             && isBoundedNullableString(request.resource.data.channel, 24)
             && request.resource.data.updateState is string
             && request.resource.data.updateState.size() <= 32
             && isBoundedNullableString(request.resource.data.lastCheckAt, 40)
             && validRuntimeComponents(request.resource.data.components)
             && validRuntimeHealth(request.resource.data.health)
             && validRuntimeMigration(request.resource.data.migration);
    }

    function validDiagnosticEvent(eventId, userId) {
      return request.resource.data.keys().hasAll([
               'schemaVersion', 'eventId', 'fingerprint', 'userId',
               'component', 'severity', 'code', 'message', 'stack',
               'context', 'occurredAt', 'receivedAt', 'suiteVersion',
               'channel'
             ])
             && request.resource.data.keys().hasOnly([
               'schemaVersion', 'eventId', 'fingerprint', 'userId',
               'component', 'severity', 'code', 'message', 'stack',
               'context', 'occurredAt', 'receivedAt', 'suiteVersion',
               'channel'
             ])
             && request.resource.data.schemaVersion == 1
             && request.resource.data.eventId is string
             && request.resource.data.eventId == eventId
             && request.resource.data.eventId.size() <= 80
             && request.resource.data.fingerprint is string
             && request.resource.data.fingerprint.size() <= 64
             && request.resource.data.userId is string
             && request.resource.data.userId == userId
             && request.resource.data.component is string
             && request.resource.data.component.size() <= 48
             && request.resource.data.severity in ['warning', 'error', 'fatal']
             && request.resource.data.code is string
             && request.resource.data.code.size() <= 80
             && request.resource.data.message is string
             && request.resource.data.message.size() <= 2000
             && request.resource.data.stack is string
             && request.resource.data.stack.size() <= 8000
             && request.resource.data.context is map
             && request.resource.data.context.keys().size() <= 12
             && request.resource.data.occurredAt is string
             && request.resource.data.occurredAt.size() <= 40
             && request.resource.data.receivedAt is timestamp
             && request.resource.data.receivedAt == request.time
             && isBoundedNullableString(request.resource.data.suiteVersion, 80)
             && (
               request.resource.data.channel == null
               || request.resource.data.channel in ['main', 'develop']
             );
    }

    // Public profile surface for cross-user features (nickname/avatar only).
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create: if (isOwner(userId) || isAdmin())
                    && validPublicProfileCreate(userId);
      allow update: if (isOwner(userId) && validOwnerPublicProfileUpdate(userId))
                    || (isAdmin() && validAdminPublicProfileUpdate(userId));
      allow delete: if isAdmin();
    }

    // Lightweight user directory for coach/admin pilot lists.
    // It intentionally excludes heavy runtime projections such as stats/sessionIndex.
    match /pilotDirectory/{userId} {
      allow read: if isOwner(userId)
                  || isAdmin()
                  || (isCurrentUserCoach() && resource.data.coachId == request.auth.uid);
      allow create: if (isOwner(userId) || isAdmin())
                    && validPilotDirectoryCreate(userId);
      allow update: if (isOwner(userId) || isAdmin())
                    && validPilotDirectoryUpdate(userId);
      allow delete: if isAdmin();
    }

    // Users collection (private profile + runtime state)
    match /users/{userId} {
      // Owner can read and update own profile/runtime state, but cannot self-change role or coach assignment.
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validInitialPilotUser(userId);
      allow update: if isOwner(userId) && validOwnerUserUpdate(userId);

      // Coach can read assigned pilots only.
      allow read: if isCoachOfUser(userId);

      // Admin can read/write everything in users.
      allow read, write: if isAdmin();

      match /runtimeInstallations/{installationId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
                      && validRuntimeInstallation(installationId);
        allow update: if isOwner(userId)
                      && validRuntimeInstallation(installationId)
                      && request.resource.data.installationId == resource.data.installationId
                      && request.resource.data.startedAt == resource.data.startedAt;
        allow delete: if isAdmin();
      }

      // === Sessions subcollection ===
      match /sessions/{sessionId} {
        allow read: if isAdmin();

        // Public session sharing between authenticated users.
        allow read: if isSignedIn() && resource.data.isPublic == true;

        // Owner full access.
        allow read, write: if isOwner(userId);

        // Coach can read assigned pilot sessions.
        allow read: if isCoachOfUser(userId);

        match /rawChunks/{chunkId} {
          allow read: if isAdmin();

          // Public chunk access mirrors session sharing (denormalized field).
          allow read: if isSignedIn() && resource.data.isPublic == true;

          // Owner full access.
          allow read, write: if isOwner(userId);

          // Coach can read assigned pilot chunks.
          allow read: if isCoachOfUser(userId);
        }
      }

      match /uploads/{uploadId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }

      match /trackBests/{trackId} {
        allow read: if isAdmin();
        allow read, write: if isOwner(userId);
        allow read: if isCoachOfUser(userId);
      }

      match /trackDetailProjections/{trackId} {
        allow read: if isAdmin();
        allow read, write: if isOwner(userId);
        allow read: if isCoachOfUser(userId);
      }

      match /sessionListMeta/{docId} {
        allow read: if isAdmin();
        allow read, write: if isOwner(userId);
        allow read: if isCoachOfUser(userId);
      }

      match /sessionListPages/{pageId} {
        allow read: if isAdmin();
        allow read, write: if isOwner(userId);
        allow read: if isCoachOfUser(userId);
      }

      match /activities/{activityId} {
        allow read: if isAdmin();
        allow read, write: if isOwner(userId);
        allow read: if isCoachOfUser(userId);
      }

      match /diagnostics/{eventId} {
        allow create: if isOwner(userId)
                      && validDiagnosticEvent(eventId, userId);
        // The owner may only check a deterministic event ID so a crashed
        // outbox retry can acknowledge an already-created immutable report.
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin()
                    && request.query.limit != null
                    && request.query.limit <= 1001;
        allow delete: if isAdmin();
        allow update: if false;
      }

      match /raceCalendar/{eventId} {
        allow read: if isAdmin();
        allow read, write: if isOwner(userId);
        allow read: if isCoachOfUser(userId);
        allow create: if isCoachOfUser(userId)
                      && isCurrentUserCoach()
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.createdByRole == 'coach';
      }

      match /coachLessons/{lessonId} {
        allow read: if isAdmin();
        allow read: if isOwner(userId);
        allow read: if isCoachOfUser(userId);
        allow create: if isCoachOfUser(userId)
                      && isCurrentUserCoach()
                      && request.resource.data.coachId == request.auth.uid
                      && request.resource.data.pilotId == userId;
        allow update: if isCoachOfUser(userId)
                      && isCurrentUserCoach()
                      && resource.data.coachId == request.auth.uid
                      && request.resource.data.coachId == request.auth.uid
                      && request.resource.data.pilotId == userId;
      }
    }

    // Rules v2 requires an explicit recursive match for collection-group
    // queries. Only admins may enumerate diagnostics across all users.
    match /{path=**}/diagnostics/{eventId} {
      allow list: if isAdmin()
                  && request.query.limit != null
                  && request.query.limit <= 1001;
    }

    match /{path=**}/runtimeInstallations/{installationId} {
      allow list: if isAdmin();
    }

    // === Pit Wall: permessi fra account (PIP-359) ===
    // Il pilota delega la strategia una volta sola. L'ingegnere puo' chiedere,
    // il pilota puo' pre-autorizzare, entrambi possono revocare. Nessuno puo'
    // autorizzarsi da solo ad assistere un altro.
    match /pitwallGrants/{grantId} {
      // Su un permesso che non esiste ancora non c'e' `resource`, quindi non
      // si puo' guardare dentro il documento: si guarda l'id, che e' composto
      // dai due uid. Cosi' l'ingegnere puo' verificare se ha gia' chiesto,
      // senza che nessuno possa sondare i collegamenti fra due estranei.
      allow get: if isSignedIn()
                 && (
                   resource == null
                     ? grantId.split('__').hasAny([request.auth.uid])
                     : (resource.data.driverUid == request.auth.uid
                        || resource.data.engineerUid == request.auth.uid)
                 );
      // Ognuno enumera soltanto i propri collegamenti, mai quelli altrui.
      // La condizione guarda il documento, non la query: Firestore accetta
      // l'elenco solo se il filtro garantisce che ogni risultato la soddisfi.
      // Una query senza `where` sul proprio uid viene quindi rifiutata, invece
      // di restituire chi assiste chi a chiunque sia autenticato.
      allow list: if isSignedIn()
                  && (resource.data.driverUid == request.auth.uid
                      || resource.data.engineerUid == request.auth.uid);

      allow create: if validPitwallGrantShape(grantId, request.resource.data.driverUid, request.resource.data.engineerUid)
                    && (validPitwallGrantRequest() || validPitwallGrantPreAuthorisation());

      // Solo il pilota concede. Entrambi possono revocare: l'ingegnere ritira
      // la richiesta, il pilota toglie il permesso.
      allow update: if isSignedIn()
                    && validPitwallGrantShape(grantId, resource.data.driverUid, resource.data.engineerUid)
                    && pitwallGrantIdentityUnchanged()
                    && (
                      (resource.data.driverUid == request.auth.uid
                       && request.resource.data.status in ['granted', 'revoked'])
                      || (resource.data.engineerUid == request.auth.uid
                          && (
                            request.resource.data.status == 'revoked'
                            // Dopo una revoca l'ingegnere puo' chiedere di
                            // nuovo: torna in attesa, e decide sempre il pilota.
                            || (resource.data.status == 'revoked'
                                && request.resource.data.status == 'pending')
                            // Un "solo per questa volta" scaduto vale come
                            // revocato: si puo' chiedere di nuovo, in attesa.
                            || (resource.data.status == 'granted'
                                && resource.data.get('expiresAtMs', null) != null
                                && resource.data.expiresAtMs <= request.time.toMillis()
                                && request.resource.data.status == 'pending')
                          ))
                    );

      allow delete: if isSignedIn() && resource.data.driverUid == request.auth.uid;
    }

    // === Pit Wall: presenza, segnalazione e ordini (PIP-359) ===
    // La telemetria live NON passa da qui: viaggia diretta fra i due PC. Questo
    // ramo porta solo cio' che serve a farsi trovare e, come rete di sicurezza,
    // l'ordine di strategia, che e' raro e piccolo.
    match /pitwallSessions/{driverUid} {
      allow get: if isPitwallParticipant(driverUid);
      allow list: if isOwner(driverUid);
      allow create, update: if isOwner(driverUid) && validPitwallSession(driverUid);
      allow delete: if isOwner(driverUid);

      match /signals/{signalId} {
        allow get, list: if isPitwallParticipant(driverUid)
                         && (resource == null
                             || resource.data.to == request.auth.uid
                             || resource.data.from == request.auth.uid);
        allow create: if isPitwallParticipant(driverUid) && validPitwallSignal(driverUid);
        // La segnalazione e' effimera: chi l'ha scritta o il pilota la pulisce.
        allow delete: if isPitwallParticipant(driverUid)
                      && (resource.data.from == request.auth.uid || isOwner(driverUid));
        allow update: if false;
      }

      match /orders/{orderId} {
        allow get, list: if isPitwallParticipant(driverUid);
        // L'ingegnere autorizzato invia; il pilota non manda ordini a se stesso.
        allow create: if hasPitwallGrant(driverUid) && validPitwallOrder(orderId);
        // Solo il PC del pilota dichiara l'esito: e' l'unico che applica davvero.
        allow update: if isOwner(driverUid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'result', 'appliedAt'])
                      && request.resource.data.status in ['applying', 'applied', 'partial', 'failed', 'rejected'];
        allow delete: if isOwner(driverUid);
      }
    }
  }
}
